# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_db"
BETTER_AUTH_SECRET="RjKpDhOSqGTdH4k/fUKYQmbeNJEgaP89l0gC4HPq3Hs="

# Docker derives this automatically from APP_PORT — no need to set it for Docker.
# Only set this for local dev (bun dev) if you run on a non-3000 port.
# BETTER_AUTH_URL="http://localhost:3000"

# Set to "true" to show the demo quick-login panel on the sign-in page.
# Never enable this in production.
NEXT_PUBLIC_DEMO_MODE="true"

# ── Docker: port overrides ────────────────────────────────────────────────────
# Change these if you have conflicts with other local services.
APP_PORT=3000
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# ── Docker: Postgres credentials ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lms_db

# ── Docker: pgAdmin credentials ───────────────────────────────────────────────
PGADMIN_EMAIL=admin@lms.edu.mv
PGADMIN_PASSWORD=admin
