generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth core tables ────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  userAccount UserAccount?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ── LMS domain tables ──────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMINISTRATOR
  ADMINISTRATOR
  EDUCATOR
  STUDENT
}

enum UserAccountStatus {
  INACTIVE
  ACTIVE
  DISABLED
}

model UserAccount {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                   UserRole
  generatedIdentifier    String            @unique
  institutionalEmail     String            @unique
  status                 UserAccountStatus @default(INACTIVE)
  mustChangePassword     Boolean           @default(true)
  homeFacultyId          String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  fileAssets             FileAsset[]
  primaryModuleOfferings ModuleOffering[]  @relation("PrimaryEducatorModuleOfferings")

  studentEnrollments              Enrollment[]                @relation("StudentEnrollments")
  enrolledByEnrollments           Enrollment[]                @relation("EnrolledByEnrollments")
  createdModuleEnrollmentExceptions ModuleEnrollmentException[] @relation("CreatedModuleEnrollmentExceptions")
  authorizedCapacityOverrides     CapacityOverride[]          @relation("CapacityOverrides")
  createdClassSessions            ClassSession[]              @relation("CreatedClassSessions")
  createdAnnouncements            Announcement[]              @relation("CreatedAnnouncements")
  createdInstitutionEvents        InstitutionEvent[]          @relation("CreatedInstitutionEvents")
  createdCourseOfferingEvents     CourseOfferingEvent[]       @relation("CreatedCourseOfferingEvents")
  createdModuleOfferingEvents     ModuleOfferingEvent[]       @relation("CreatedModuleOfferingEvents")
  receivedNotifications           Notification[]              @relation("ReceivedNotifications")
  sentChatMessages                ChatMessage[]               @relation("SentChatMessages")
  moderatedChatMessages           ChatMessage[]               @relation("RemovedChatMessages")
  chatParticipantActivities       ChatParticipantActivity[]   @relation("ChatParticipantActivities")
  createdFeedbackPeriods          FeedbackPeriod[]            @relation("CreatedFeedbackPeriods")
  submittedFeedbackResponses      FeedbackResponse[]          @relation("SubmittedFeedbackResponses")
  createdContentSections          ContentSection[]            @relation("CreatedContentSections")
  createdModuleContent            ModuleContent[]             @relation("CreatedModuleContent")
  createdAssignments              Assignment[]                @relation("CreatedAssignments")
  createdDeadlineExtensions       AssignmentDeadlineExtension[] @relation("CreatedDeadlineExtensions")
  assignmentSubmissions           AssignmentSubmission[]      @relation("StudentSubmissions")
  studentAttendanceRecords        AttendanceRecord[]          @relation("StudentAttendanceRecords")
  submittedAttendanceRecords      AttendanceRecord[]          @relation("SubmittedAttendanceRecords")
  educatorAttendanceRecords       EducatorAttendanceRecord[]  @relation("EducatorAttendanceRecords")
  requestedCorrectionRequests     AttendanceCorrectionRequest[] @relation("RequestedCorrectionRequests")
  resolvedCorrectionRequests      AttendanceCorrectionRequest[] @relation("ResolvedCorrectionRequests")
  createdAssessmentComponents     AssessmentComponent[]       @relation("CreatedAssessmentComponents")
  studentComponentMarks           ComponentMark[]             @relation("StudentComponentMarks")
  markedComponentMarks            ComponentMark[]             @relation("MarkedComponentMarks")
  studentFinalGrades              FinalGrade[]                @relation("StudentFinalGrades")
  releasedFinalGrades             FinalGrade[]                @relation("ReleasedFinalGrades")
  approvedFinalGradeCorrections   FinalGradeCorrection[]      @relation("ApprovedFinalGradeCorrections")
  correctedComponentMarks         MarkCorrection[]            @relation("MarkCorrections")
}

// ── Academic catalogue ────────────────────────────────────────────────────

enum CatalogueStatus {
  ACTIVE
  INACTIVE
}

enum AwardLevel {
  FOUNDATION
  DIPLOMA
  DEGREE
  MASTERS
  PHD
}

model Faculty {
  id        String          @id @default(cuid())
  name      String
  status    CatalogueStatus @default(ACTIVE)
  courses   Course[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Course {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  awardLevel         AwardLevel
  awardingBody       String?
  facultyId          String
  faculty            Faculty             @relation(fields: [facultyId], references: [id])
  status             CatalogueStatus     @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  curriculumTemplate CurriculumTemplate?
  courseOfferings    CourseOffering[]
}

model Module {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  status          CatalogueStatus  @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  templateModules TemplateModule[]
}

model Intake {
  id              String           @id @default(cuid())
  name            String
  status          CatalogueStatus  @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  courseOfferings CourseOffering[]
}

model StudyMode {
  id              String           @id @default(cuid())
  name            String
  status          CatalogueStatus  @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  courseOfferings CourseOffering[]
  moduleOfferings ModuleOffering[]
}

model SessionType {
  id            String          @id @default(cuid())
  name          String
  status        CatalogueStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  classSessions ClassSession[]
}

// ── Audit Log ─────────────────────────────────────────────────────────────

enum AuditEventType {
  SYSTEM
  OPERATIONAL
}

model AuditLogEntry {
  id         String         @id @default(cuid())
  eventType  AuditEventType
  action     String
  actorId    String
  entityType String
  entityId   String?
  beforeJson String?
  afterJson  String?
  reason     String?
  createdAt  DateTime       @default(now())
}

// ── System Settings ────────────────────────────────────────────────────────

model SystemSettings {
  id                                   String   @id @default(cuid())
  defaultReminderPeriodDays            Int      @default(15)
  attendanceCorrectionWindowDays       Int      @default(8)
  passThresholdPercent                 Float    @default(50)
  attendanceRiskThresholdPercent       Float    @default(80)
  postCourseMarkingWindowDays          Int      @default(14)
  maxUploadBytesChatAttachment         Int      @default(10485760)
  maxUploadBytesSubmission             Int      @default(104857600)
  maxUploadBytesContentAttachment      Int      @default(52428800)
  maxUploadBytesAnnouncementAttachment Int      @default(20971520)
  updatedAt                            DateTime @updatedAt
}

// ── File storage ───────────────────────────────────────────────────────────

enum FileCategory {
  CHAT_ATTACHMENT
  SUBMISSION
  CONTENT_ATTACHMENT
  ANNOUNCEMENT_ATTACHMENT
  ASSIGNMENT_ATTACHMENT
}

enum FileAssetStatus {
  ACTIVE
  DELETED
}

model FileAsset {
  id               String          @id @default(cuid())
  storageDriver    String
  storageKey       String          @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  category         FileCategory
  uploadedById     String
  uploadedBy       UserAccount     @relation(fields: [uploadedById], references: [id])
  status           FileAssetStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  announcementAttachments AnnouncementAttachment[]
  chatMessageAttachments  ChatMessageAttachment[]
  contentAttachments      ContentAttachment[]
  assignmentAttachments   AssignmentAttachment[]
  assignmentSubmission    AssignmentSubmission?
}

// ── Curriculum Templates ───────────────────────────────────────────────────

model CurriculumTemplate {
  id        String          @id @default(cuid())
  courseId  String          @unique
  course    Course          @relation(fields: [courseId], references: [id])
  status    CatalogueStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  academicLevels  AcademicLevel[]
  templateModules TemplateModule[]
}

model AcademicLevel {
  id                   String             @id @default(cuid())
  curriculumTemplateId String
  curriculumTemplate   CurriculumTemplate @relation(fields: [curriculumTemplateId], references: [id], onDelete: Cascade)
  label                String
  sortOrder            Int
  expectedCredits      Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  templateModules TemplateModule[]
}

model TemplateModule {
  id                   String             @id @default(cuid())
  curriculumTemplateId String
  curriculumTemplate   CurriculumTemplate @relation(fields: [curriculumTemplateId], references: [id], onDelete: Cascade)
  academicLevelId      String
  academicLevel        AcademicLevel      @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)
  moduleId             String
  module               Module             @relation(fields: [moduleId], references: [id])
  credits              Int
  sortOrder            Int
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  prerequisites               TemplateModulePrerequisite[] @relation("Dependent")
  dependents                  TemplateModulePrerequisite[] @relation("Prerequisite")
  defaultAssessmentComponents DefaultAssessmentComponent[]
  moduleOfferings             ModuleOffering[]
}

model TemplateModulePrerequisite {
  templateModuleId String
  templateModule   TemplateModule @relation("Dependent", fields: [templateModuleId], references: [id], onDelete: Cascade)
  prerequisiteId   String
  prerequisite     TemplateModule @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([templateModuleId, prerequisiteId])
}

enum AssessmentComponentType {
  ONLINE_ASSIGNMENT
  OFFLINE_ASSESSMENT
}

model DefaultAssessmentComponent {
  id               String                  @id @default(cuid())
  templateModuleId String
  templateModule   TemplateModule          @relation(fields: [templateModuleId], references: [id], onDelete: Cascade)
  title            String
  type             AssessmentComponentType
  weightPercent    Float
  maximumMark      Float
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

// ── Course Delivery ──────────────────────────────────────────────────────

enum OfferingStatus {
  PLANNED
  ACTIVE
  ARCHIVED
}

model CourseOffering {
  id          String         @id @default(cuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id])
  intakeId    String
  intake      Intake         @relation(fields: [intakeId], references: [id])
  studyModeId String
  studyMode   StudyMode      @relation(fields: [studyModeId], references: [id])
  name        String
  startAt     DateTime
  finishAt    DateTime
  capacity    Int            @default(24)
  status      OfferingStatus @default(PLANNED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  moduleOfferings     ModuleOffering[]
  enrollments         Enrollment[]
  announcements       Announcement[]
  courseOfferingEvents CourseOfferingEvent[]

  @@unique([courseId, intakeId])
}

model ModuleOffering {
  id                String         @id @default(cuid())
  courseOfferingId  String
  courseOffering    CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  templateModuleId  String
  templateModule    TemplateModule @relation(fields: [templateModuleId], references: [id])
  primaryEducatorId String
  primaryEducator   UserAccount    @relation("PrimaryEducatorModuleOfferings", fields: [primaryEducatorId], references: [id])
  studyModeId       String?
  studyMode         StudyMode?     @relation(fields: [studyModeId], references: [id])
  startAt           DateTime
  finishAt          DateTime
  status            OfferingStatus @default(PLANNED)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  moduleGroupChat             ModuleGroupChat?
  moduleEnrollmentExceptions  ModuleEnrollmentException[]
  classSessions               ClassSession[]
  announcements               Announcement[]
  feedbackPeriod              FeedbackPeriod?
  contentSections             ContentSection[]
  assignments                 Assignment[]
  assessmentComponents        AssessmentComponent[]
  finalGrades                 FinalGrade[]
  moduleOfferingEvents        ModuleOfferingEvent[]

  @@unique([courseOfferingId, templateModuleId])
}

model ModuleGroupChat {
  id               String         @id @default(cuid())
  moduleOfferingId String         @unique
  moduleOffering   ModuleOffering @relation(fields: [moduleOfferingId], references: [id], onDelete: Cascade)
  isReadOnly       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  messages             ChatMessage[]
  participantActivities ChatParticipantActivity[]
}

enum ChatMessageStatus {
  ACTIVE
  EDITED
  REMOVED
}

model ChatMessage {
  id               String            @id @default(cuid())
  chatId           String
  chat             ModuleGroupChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId         String
  sender           UserAccount       @relation("SentChatMessages", fields: [senderId], references: [id])
  body             String
  status           ChatMessageStatus @default(ACTIVE)
  editedAt         DateTime?
  moderationReason String?
  removedById      String?
  removedBy        UserAccount?      @relation("RemovedChatMessages", fields: [removedById], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  attachments ChatMessageAttachment[]
  sharedLinks ChatMessageSharedLink[]
}

model ChatMessageAttachment {
  id          String      @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAssetId String
  fileAsset   FileAsset   @relation(fields: [fileAssetId], references: [id])
  createdAt   DateTime    @default(now())
}

model ChatMessageSharedLink {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  createdAt DateTime    @default(now())
}

model ChatParticipantActivity {
  chatId     String
  chat       ModuleGroupChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       UserAccount     @relation("ChatParticipantActivities", fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime

  @@id([chatId, userId])
}

// ── Enrollment ─────────────────────────────────────────────────────────────

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

enum ExceptionType {
  INCLUDE
  EXCLUDE
}

model Enrollment {
  id               String           @id @default(cuid())
  studentId        String
  student          UserAccount      @relation("StudentEnrollments", fields: [studentId], references: [id])
  courseOfferingId String
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id])
  isMainEnrollment Boolean          @default(false)
  status           EnrollmentStatus @default(ACTIVE)
  enrolledById     String
  enrolledBy       UserAccount      @relation("EnrolledByEnrollments", fields: [enrolledById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  moduleEnrollmentExceptions ModuleEnrollmentException[]
  capacityOverride           CapacityOverride?

  @@unique([studentId, courseOfferingId])
}

model ModuleEnrollmentException {
  id               String         @id @default(cuid())
  enrollmentId     String
  enrollment       Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleOfferingId String
  moduleOffering   ModuleOffering @relation(fields: [moduleOfferingId], references: [id])
  exceptionType    ExceptionType
  reason           String
  createdById      String
  createdBy        UserAccount    @relation("CreatedModuleEnrollmentExceptions", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([enrollmentId, moduleOfferingId])
}

model CapacityOverride {
  id             String     @id @default(cuid())
  enrollmentId   String     @unique
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reason         String
  authorizedById String
  authorizedBy   UserAccount @relation("CapacityOverrides", fields: [authorizedById], references: [id])
  createdAt      DateTime   @default(now())
}

// ── Announcements ─────────────────────────────────────────────────────────

enum AnnouncementScope {
  INSTITUTION
  COURSE_OFFERING
  MODULE_OFFERING
}

model Announcement {
  id               String            @id @default(cuid())
  scope            AnnouncementScope
  courseOfferingId String?
  courseOffering   CourseOffering?   @relation(fields: [courseOfferingId], references: [id])
  moduleOfferingId String?
  moduleOffering   ModuleOffering?   @relation(fields: [moduleOfferingId], references: [id])
  body             String
  expiresAt        DateTime?
  createdById      String
  createdBy        UserAccount       @relation("CreatedAnnouncements", fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  attachments   AnnouncementAttachment[]
  sharedLinks   AnnouncementSharedLink[]
  notifications Notification[]
}

model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  fileAssetId    String
  fileAsset      FileAsset    @relation(fields: [fileAssetId], references: [id])
  createdAt      DateTime     @default(now())
}

model AnnouncementSharedLink {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  url            String
  title          String?
  createdAt      DateTime     @default(now())
}

// ── Academic Calendar ─────────────────────────────────────────────────────

model InstitutionEvent {
  id          String      @id @default(cuid())
  title       String
  startAt     DateTime
  finishAt    DateTime?
  createdById String
  createdBy   UserAccount @relation("CreatedInstitutionEvents", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CourseOfferingEvent {
  id               String         @id @default(cuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  title            String
  startAt          DateTime
  finishAt         DateTime?
  createdById      String
  createdBy        UserAccount    @relation("CreatedCourseOfferingEvents", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ModuleOfferingEvent {
  id               String         @id @default(cuid())
  moduleOfferingId String
  moduleOffering   ModuleOffering @relation(fields: [moduleOfferingId], references: [id], onDelete: Cascade)
  title            String
  startAt          DateTime
  finishAt         DateTime?
  createdById      String
  createdBy        UserAccount    @relation("CreatedModuleOfferingEvents", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ── Notifications ──────────────────────────────────────────────────────────

enum NotificationSourceType {
  ANNOUNCEMENT
  MODULE_CONTENT
  ASSIGNMENT
  COMPONENT_MARK
  FINAL_GRADE
}

model Notification {
  id               String                 @id @default(cuid())
  recipientId      String
  recipient        UserAccount            @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sourceType       NotificationSourceType
  announcementId   String?
  announcement     Announcement?          @relation(fields: [announcementId], references: [id])
  moduleContentId  String?
  moduleContent    ModuleContent?         @relation(fields: [moduleContentId], references: [id])
  assignmentId     String?
  assignment       Assignment?            @relation(fields: [assignmentId], references: [id])
  componentMarkId  String?
  componentMark    ComponentMark?         @relation(fields: [componentMarkId], references: [id])
  finalGradeId     String?
  finalGrade       FinalGrade?            @relation(fields: [finalGradeId], references: [id])
  title            String
  readAt           DateTime?
  createdAt        DateTime               @default(now())
}

// ── Class Sessions ─────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CorrectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClassSession {
  id                 String         @id @default(cuid())
  moduleOfferingId   String
  moduleOffering     ModuleOffering @relation(fields: [moduleOfferingId], references: [id], onDelete: Cascade)
  sessionTypeId      String
  sessionType        SessionType    @relation(fields: [sessionTypeId], references: [id])
  startAt            DateTime
  finishAt           DateTime
  sessionLocation    String?
  attendanceRequired Boolean        @default(true)
  createdById        String
  createdBy          UserAccount    @relation("CreatedClassSessions", fields: [createdById], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  attendanceRecords     AttendanceRecord[]
  educatorAttendance    EducatorAttendanceRecord?
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  classSessionId String
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        UserAccount      @relation("StudentAttendanceRecords", fields: [studentId], references: [id])
  status         AttendanceStatus
  submittedById  String
  submittedBy    UserAccount      @relation("SubmittedAttendanceRecords", fields: [submittedById], references: [id])
  submittedAt    DateTime
  lockedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  correctionRequests AttendanceCorrectionRequest[]

  @@unique([classSessionId, studentId])
}

model EducatorAttendanceRecord {
  id                     String       @id @default(cuid())
  classSessionId         String       @unique
  classSession           ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  educatorId             String
  educator               UserAccount  @relation("EducatorAttendanceRecords", fields: [educatorId], references: [id])
  submittedAttendanceAt DateTime
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model AttendanceCorrectionRequest {
  id                String                  @id @default(cuid())
  attendanceRecordId String
  attendanceRecord  AttendanceRecord        @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedById     String
  requestedBy       UserAccount             @relation("RequestedCorrectionRequests", fields: [requestedById], references: [id])
  requestedStatus   AttendanceStatus
  reason            String
  status            CorrectionRequestStatus @default(PENDING)
  resolvedById      String?
  resolvedBy        UserAccount?            @relation("ResolvedCorrectionRequests", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

// ── Module Feedback ────────────────────────────────────────────────────────

enum FeedbackResponseStatus {
  ACTIVE
  MODERATED
}

model FeedbackPeriod {
  id               String         @id @default(cuid())
  moduleOfferingId String         @unique
  moduleOffering   ModuleOffering @relation(fields: [moduleOfferingId], references: [id], onDelete: Cascade)
  openAt           DateTime
  closeAt          DateTime
  createdById      String
  createdBy        UserAccount    @relation("CreatedFeedbackPeriods", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  responses FeedbackResponse[]
}

model FeedbackResponse {
  id               String                 @id @default(cuid())
  feedbackPeriodId String
  feedbackPeriod   FeedbackPeriod         @relation(fields: [feedbackPeriodId], references: [id], onDelete: Cascade)
  studentId        String
  student          UserAccount            @relation("SubmittedFeedbackResponses", fields: [studentId], references: [id])
  rating           Int
  comment          String?
  status           FeedbackResponseStatus @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([feedbackPeriodId, studentId])
}

// ── Module Content ─────────────────────────────────────────────────────────────

model ContentSection {
  id               String         @id @default(cuid())
  moduleOfferingId String
  moduleOffering   ModuleOffering @relation(fields: [moduleOfferingId], references: [id], onDelete: Cascade)
  title            String
  sortOrder        Int
  createdById      String
  createdBy        UserAccount    @relation("CreatedContentSections", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  contentItems     ModuleContent[]
  linkedAssignments Assignment[]
}

enum ModuleContentStatus {
  DRAFT
  PUBLISHED
}

model ModuleContent {
  id               String              @id @default(cuid())
  contentSectionId String
  contentSection   ContentSection      @relation(fields: [contentSectionId], references: [id], onDelete: Cascade)
  title            String
  body             String
  status           ModuleContentStatus @default(DRAFT)
  sortOrder        Int
  createdById      String
  createdBy        UserAccount         @relation("CreatedModuleContent", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  attachments   ContentAttachment[]
  sharedLinks   ContentSharedLink[]
  notifications Notification[]
}

model ContentAttachment {
  id            String        @id @default(cuid())
  contentItemId String
  contentItem   ModuleContent @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  fileAssetId   String
  fileAsset     FileAsset     @relation(fields: [fileAssetId], references: [id])
  createdAt     DateTime      @default(now())
}

model ContentSharedLink {
  id            String        @id @default(cuid())
  contentItemId String
  contentItem   ModuleContent @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  url           String
  title         String?
  createdAt     DateTime      @default(now())
}

// ── Assignments ────────────────────────────────────────────────────────────────

enum AssignmentStatus {
  DRAFT
  PUBLISHED
}

model Assignment {
  id               String           @id @default(cuid())
  moduleOfferingId String
  moduleOffering   ModuleOffering   @relation(fields: [moduleOfferingId], references: [id], onDelete: Cascade)
  contentSectionId String?
  contentSection   ContentSection?  @relation(fields: [contentSectionId], references: [id])
  title            String
  body             String
  deadline         DateTime
  maximumMark      Float
  status           AssignmentStatus @default(DRAFT)
  createdById      String
  createdBy        UserAccount      @relation("CreatedAssignments", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  attachments         AssignmentAttachment[]
  sharedLinks         AssignmentSharedLink[]
  notifications       Notification[]
  submissions         AssignmentSubmission[]
  assessmentComponent AssessmentComponent?
  deadlineExtensions  AssignmentDeadlineExtension[]
}

model AssignmentAttachment {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileAssetId  String
  fileAsset    FileAsset  @relation(fields: [fileAssetId], references: [id])
  createdAt    DateTime   @default(now())
}

model AssignmentSharedLink {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  url          String
  title        String?
  createdAt    DateTime   @default(now())
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  MARKED
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      UserAccount      @relation("StudentSubmissions", fields: [studentId], references: [id])
  fileAssetId  String           @unique
  fileAsset    FileAsset        @relation(fields: [fileAssetId], references: [id])
  status       SubmissionStatus
  submittedAt  DateTime
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
}

model AssignmentDeadlineExtension {
  id             String     @id @default(cuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  oldDeadline    DateTime
  newDeadline    DateTime
  reason         String
  createdById    String
  createdBy      UserAccount @relation("CreatedDeadlineExtensions", fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())
}

// ── Assessment Structure and Marking ──────────────────────────────────────────

model AssessmentComponent {
  id               String                  @id @default(cuid())
  moduleOfferingId String
  moduleOffering   ModuleOffering          @relation(fields: [moduleOfferingId], references: [id], onDelete: Cascade)
  assignmentId     String?                 @unique
  assignment       Assignment?             @relation(fields: [assignmentId], references: [id])
  title            String
  type             AssessmentComponentType
  weightPercent    Float
  maximumMark      Float
  sortOrder        Int
  createdById      String
  createdBy        UserAccount             @relation("CreatedAssessmentComponents", fields: [createdById], references: [id])
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  componentMarks ComponentMark[]
}

enum ComponentMarkStatus {
  DRAFT
  RELEASED
}

model ComponentMark {
  id                    String               @id @default(cuid())
  assessmentComponentId String
  assessmentComponent   AssessmentComponent  @relation(fields: [assessmentComponentId], references: [id], onDelete: Cascade)
  studentId             String
  student               UserAccount          @relation("StudentComponentMarks", fields: [studentId], references: [id])
  score                 Float
  feedback              String?
  status                ComponentMarkStatus  @default(DRAFT)
  markedById            String
  markedBy              UserAccount          @relation("MarkedComponentMarks", fields: [markedById], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  notifications Notification[]
  corrections   MarkCorrection[]

  @@unique([assessmentComponentId, studentId])
}

model MarkCorrection {
  id              String        @id @default(cuid())
  componentMarkId String
  componentMark   ComponentMark @relation(fields: [componentMarkId], references: [id], onDelete: Cascade)
  oldScore        Float
  oldFeedback     String?
  newScore        Float
  newFeedback     String?
  reason          String
  correctedById   String
  correctedBy     UserAccount   @relation("MarkCorrections", fields: [correctedById], references: [id])
  createdAt       DateTime      @default(now())
}

enum FinalGradeStatus {
  PROVISIONAL
  RELEASED
}

model FinalGrade {
  id               String           @id @default(cuid())
  moduleOfferingId String
  moduleOffering   ModuleOffering   @relation(fields: [moduleOfferingId], references: [id], onDelete: Cascade)
  studentId        String
  student          UserAccount      @relation("StudentFinalGrades", fields: [studentId], references: [id])
  percentage       Float
  isPassing        Boolean
  status           FinalGradeStatus @default(PROVISIONAL)
  releasedById     String
  releasedBy       UserAccount      @relation("ReleasedFinalGrades", fields: [releasedById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  notifications Notification[]
  corrections   FinalGradeCorrection[]

  @@unique([moduleOfferingId, studentId])
}

model FinalGradeCorrection {
  id            String      @id @default(cuid())
  finalGradeId  String
  finalGrade    FinalGrade  @relation(fields: [finalGradeId], references: [id], onDelete: Cascade)
  oldPercentage Float
  oldIsPassing  Boolean
  newPercentage Float
  newIsPassing  Boolean
  reason        String
  approvedById  String
  approvedBy    UserAccount @relation("ApprovedFinalGradeCorrections", fields: [approvedById], references: [id])
  createdAt     DateTime    @default(now())
}
